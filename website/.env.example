# Base URL of the Dinequora restaurant application (TanStack Start app).
# "Login" links to <VITE_APP_URL>/auth and "Create account" links to <VITE_APP_URL>/signup.
# Leave empty to use same-origin relative links (/auth, /signup).
VITE_APP_URL=

# Login / Create account links. Off unless exactly "true": while the application is not
# published, the header, mobile menu and footer show "Coming soon" and link nowhere.
# Set to "true" (together with VITE_APP_URL) once the application is live.
VITE_APP_LINKS_ENABLED=

# Endpoint that receives demo-request submissions as JSON (POST).
# Until this is set, the form validates input but does NOT send anything and says so.
# A cross-origin endpoint must also be added to connect-src in public/_headers (the build fails otherwise).
VITE_DEMO_REQUEST_ENDPOINT=

# Canonical public URL of this marketing site (used for canonical/OG tags at build time).
VITE_SITE_URL=
