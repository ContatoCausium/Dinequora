# Example environment. Copy to .env (never committed) and fill only what is approved.
# No real value belongs in this file.

# Supabase (local stack values come from `npx supabase status`)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public support address shown in the app. Leave empty until the mailbox exists
# (planned: the Dinequora support mailbox, not yet confirmed).
VITE_SUPPORT_EMAIL=

# Server-side alerting for critical errors (POST JSON, already redacted). https only.
# Empty = disabled: nothing leaves the server.
OBSERVABILITY_ALERT_WEBHOOK_URL=
# Label added to alerts, e.g. production / staging
OBSERVABILITY_ENVIRONMENT=
